---
import '../styles/kinetic.css'
import { getLocaleFromUrl, type Locale } from '../i18n/utils'

interface Props {
  title: string
  description?: string
  locale?: Locale
}

const urlLocale = getLocaleFromUrl(Astro.url)
const { title, description = 'TAM ATB Architecture - Marbella', locale = urlLocale } = Astro.props
const langMap = { en: 'en', es: 'es', zh: 'zh-CN' }
---

<!doctype html>
<html lang={langMap[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | TAM ATB Architecture</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="kinetic-body">
    <slot />
  </body>
</html>
