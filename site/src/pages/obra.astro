---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Obra" description="Construction and building projects">
  <section class="py-12 px-6">
    <div class="container mx-auto">
      <h1 class="text-4xl font-light tracking-wide text-gray-900 mb-4">Obra</h1>
      <p class="text-gray-600 mb-12 max-w-2xl">
        Construction projects showcasing our commitment to quality craftsmanship
        and attention to detail throughout the building process.
      </p>

      <!-- Construction Projects -->
      <div class="space-y-16">
        {[1, 2, 3].map((i) => (
          <div class="grid lg:grid-cols-2 gap-8 items-center">
            <div class={`aspect-video bg-gray-200 flex items-center justify-center ${i % 2 === 0 ? 'lg:order-2' : ''}`}>
              <span class="text-gray-400">Construction Project {i}</span>
            </div>
            <div class={i % 2 === 0 ? 'lg:order-1' : ''}>
              <h3 class="text-2xl font-light text-gray-900 mb-4">Construction Project {i}</h3>
              <p class="text-gray-600 leading-relaxed mb-4">
                Detailed description of the construction project, including scope,
                challenges overcome, and notable achievements in the building process.
              </p>
              <dl class="grid grid-cols-2 gap-4 text-sm">
                <div>
                  <dt class="text-gray-500">Location</dt>
                  <dd class="text-gray-900">Marbella</dd>
                </div>
                <div>
                  <dt class="text-gray-500">Year</dt>
                  <dd class="text-gray-900">2024</dd>
                </div>
                <div>
                  <dt class="text-gray-500">Area</dt>
                  <dd class="text-gray-900">500 m²</dd>
                </div>
                <div>
                  <dt class="text-gray-500">Status</dt>
                  <dd class="text-gray-900">Completed</dd>
                </div>
              </dl>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
