---
import Layout from '../layouts/Layout.astro'
import { useTranslations, type Locale } from '../i18n/utils'

export interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const t = useTranslations(locale)

// Placeholder construction projects - to be filled by user
const constructionProjects = [
  {
    title: 'Construction Project 1',
    description: 'Detailed description of the construction project, including scope, challenges overcome, and notable achievements in the building process.',
    location: 'Marbella',
    year: '2024',
    area: '500 m²',
    status: 'Completed',
  },
  {
    title: 'Construction Project 2',
    description: 'Detailed description of the construction project, including scope, challenges overcome, and notable achievements in the building process.',
    location: 'Marbella',
    year: '2023',
    area: '750 m²',
    status: 'Completed',
  },
  {
    title: 'Construction Project 3',
    description: 'Detailed description of the construction project, including scope, challenges overcome, and notable achievements in the building process.',
    location: 'Marbella',
    year: '2023',
    area: '400 m²',
    status: 'In Progress',
  },
]
---

<Layout title={t.obra.title} locale={locale} description={t.obra.subtitle}>
  <section class="py-12 px-6">
    <div class="container mx-auto">
      <h1 class="text-4xl font-light tracking-wide text-gray-900 mb-4">{t.obra.title}</h1>
      <p class="text-gray-600 mb-12 max-w-2xl">
        {t.obra.subtitle}
      </p>

      <!-- Construction Projects -->
      <div class="space-y-16">
        {constructionProjects.map((project, i) => (
          <div class="grid lg:grid-cols-2 gap-8 items-center">
            <div class={`aspect-video bg-gray-200 flex items-center justify-center ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
              <span class="text-gray-400">{project.title}</span>
            </div>
            <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
              <h3 class="text-2xl font-light text-gray-900 mb-4">{project.title}</h3>
              <p class="text-gray-600 leading-relaxed mb-6">
                {project.description}
              </p>
              <dl class="grid grid-cols-2 gap-4 text-sm">
                <div>
                  <dt class="text-gray-500">Location</dt>
                  <dd class="text-gray-900 font-medium">{project.location}</dd>
                </div>
                <div>
                  <dt class="text-gray-500">Year</dt>
                  <dd class="text-gray-900 font-medium">{project.year}</dd>
                </div>
                <div>
                  <dt class="text-gray-500">Area</dt>
                  <dd class="text-gray-900 font-medium">{project.area}</dd>
                </div>
                <div>
                  <dt class="text-gray-500">Status</dt>
                  <dd class="text-gray-900 font-medium">{project.status}</dd>
                </div>
              </dl>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
