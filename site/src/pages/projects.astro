---
import Layout from '../layouts/Layout.astro'
import { projects } from '../data/projects'
---

<Layout title="Proyectos" description="Explora nuestro portfolio de proyectos arquitectónicos">
  <section class="py-12 px-6">
    <div class="container mx-auto">
      <h1 class="text-4xl font-light tracking-wide text-gray-900 mb-4">Proyectos</h1>
      <p class="text-gray-600 mb-12 max-w-2xl">
        Una selección de nuestro trabajo arquitectónico abarcando espacios residenciales, comerciales y públicos.
      </p>

      <!-- Projects Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((project) => (
          <a href={`/projects/${project.id}`} class="group">
            <div class="aspect-[4/3] bg-gray-200 overflow-hidden">
              <div class="w-full h-full bg-gradient-to-br from-gray-200 to-gray-300 group-hover:scale-105 transition-transform duration-500 flex items-center justify-center">
                <span class="text-gray-400 text-sm">{project.title}</span>
              </div>
            </div>
            <h3 class="mt-4 text-lg font-light text-gray-900 group-hover:text-gray-600 transition-colors">
              {project.title}
            </h3>
            <p class="text-sm text-gray-500">{project.location} • {project.year}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
