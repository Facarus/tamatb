---
import Layout from '../../layouts/Layout.astro'
import { useTranslations } from '../../i18n/utils'

const locale = 'es'
const t = useTranslations(locale)

const constructionProjects = [
  { title: 'Proyecto de Construcción 1', description: 'Descripción detallada del proyecto de construcción.', location: 'Marbella', year: '2024', area: '500 m²', status: 'Completado' },
  { title: 'Proyecto de Construcción 2', description: 'Descripción detallada del proyecto de construcción.', location: 'Marbella', year: '2023', area: '750 m²', status: 'Completado' },
  { title: 'Proyecto de Construcción 3', description: 'Descripción detallada del proyecto de construcción.', location: 'Marbella', year: '2023', area: '400 m²', status: 'En Progreso' },
]
---

<Layout title={t.obra.title} locale={locale} description={t.obra.subtitle}>
  <section class="py-12 px-6">
    <div class="container mx-auto">
      <h1 class="text-4xl font-light tracking-wide text-gray-900 mb-4">{t.obra.title}</h1>
      <p class="text-gray-600 mb-12 max-w-2xl">{t.obra.subtitle}</p>

      <div class="space-y-16">
        {constructionProjects.map((project, i) => (
          <div class="grid lg:grid-cols-2 gap-8 items-center">
            <div class={`aspect-video bg-gray-200 flex items-center justify-center ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
              <span class="text-gray-400">{project.title}</span>
            </div>
            <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
              <h3 class="text-2xl font-light text-gray-900 mb-4">{project.title}</h3>
              <p class="text-gray-600 leading-relaxed mb-6">{project.description}</p>
              <dl class="grid grid-cols-2 gap-4 text-sm">
                <div><dt class="text-gray-500">Ubicación</dt><dd class="text-gray-900 font-medium">{project.location}</dd></div>
                <div><dt class="text-gray-500">Año</dt><dd class="text-gray-900 font-medium">{project.year}</dd></div>
                <div><dt class="text-gray-500">Área</dt><dd class="text-gray-900 font-medium">{project.area}</dd></div>
                <div><dt class="text-gray-500">Estado</dt><dd class="text-gray-900 font-medium">{project.status}</dd></div>
              </dl>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
