---
import Layout from '../layouts/Layout.astro'
import { useTranslations, type Locale } from '../i18n/utils'

export interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const t = useTranslations(locale)
const base = import.meta.env.BASE_URL || "/"
---

<Layout title={t.contact.title} locale={locale} description="Get in touch with TAM ATB Architecture">
  <section class="py-12 px-6">
    <div class="container mx-auto">
      <h1 class="text-4xl font-light tracking-wide text-gray-900 mb-4">{t.contact.title}</h1>
      <p class="text-gray-600 mb-12 max-w-2xl">
        {t.contact.getInTouch}
      </p>

      <div class="grid lg:grid-cols-2 gap-16">
        <!-- Contact Form -->
        <div>
          <h2 class="text-2xl font-light text-gray-900 mb-6">{t.contact.getInTouch}</h2>
          <form class="space-y-6" action="#" method="POST">
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm text-gray-600 mb-2">{t.contact.name}</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 border border-gray-300 focus:border-gray-900 focus:outline-none transition-colors"
                />
              </div>
              <div>
                <label for="email" class="block text-sm text-gray-600 mb-2">{t.contact.email}</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 border border-gray-300 focus:border-gray-900 focus:outline-none transition-colors"
                />
              </div>
            </div>
            <div>
              <label for="phone" class="block text-sm text-gray-600 mb-2">{t.contact.phone}</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full px-4 py-3 border border-gray-300 focus:border-gray-900 focus:outline-none transition-colors"
              />
            </div>
            <div>
              <label for="message" class="block text-sm text-gray-600 mb-2">{t.contact.message}</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full px-4 py-3 border border-gray-300 focus:border-gray-900 focus:outline-none transition-colors resize-none"
              ></textarea>
            </div>
            <button
              type="submit"
              class="px-8 py-3 bg-gray-900 text-white hover:bg-gray-800 transition-colors text-sm tracking-wide"
            >
              {t.contact.send}
            </button>
          </form>
        </div>

        <!-- Contact Info & Map -->
        <div>
          <div class="mb-8">
            <img src={`${base}images/contact/hero.jpg`} alt="TAM ATB Office" class="w-full aspect-video object-cover mb-8" />
          </div>

          <div class="space-y-6 mb-8">
            <div>
              <h3 class="text-sm font-medium text-gray-900 mb-1">{t.contact.email}</h3>
              <p class="text-gray-600">
                <a href="mailto:info@tamatb.com" class="hover:text-gray-900 transition-colors">
                  info@tamatb.com
                </a>
              </p>
              <p class="text-gray-600">
                <a href="mailto:administracion@marbellarchitecture.com" class="hover:text-gray-900 transition-colors">
                  administracion@marbellarchitecture.com
                </a>
              </p>
            </div>

            <div>
              <h3 class="text-sm font-medium text-gray-900 mb-1">{t.contact.phone}</h3>
              <p class="text-gray-600">
                <a href="tel:+34952810700" class="hover:text-gray-900 transition-colors">
                  (+34) 952 81 07 00
                </a>
              </p>
            </div>

            <div>
              <h3 class="text-sm font-medium text-gray-900 mb-1">{t.contact.address}</h3>
              <address class="not-italic text-gray-600 leading-relaxed">
                Avda. del Prado esq. C/Londres<br />
                Urb. Miragolf. Fase III. 33 - 35<br />
                29660, Nueva Andalucía, Marbella
              </address>
            </div>
          </div>

          <!-- Google Maps -->
          <div>
            <h3 class="text-sm font-medium text-gray-900 mb-4">{t.contact.findUs}</h3>
            <div class="aspect-video bg-gray-200 overflow-hidden">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3223.1!2d-4.95!3d36.48!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzbCsDI4JzQ4LjAiTiA0wrA1NycwMC4wIlc!5e0!3m2!1sen!2ses!4v1600000000000!5m2!1sen!2ses"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="TAM ATB Architecture Location"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
