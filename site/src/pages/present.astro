---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Present" description="Current projects and ongoing work">
  <section class="py-12 px-6">
    <div class="container mx-auto">
      <h1 class="text-4xl font-light tracking-wide text-gray-900 mb-4">Present</h1>
      <p class="text-gray-600 mb-12 max-w-2xl">
        Current projects in development and ongoing architectural work.
      </p>

      <!-- Current Projects -->
      <div class="grid md:grid-cols-2 gap-12">
        {[1, 2].map((i) => (
          <div class="group">
            <div class="aspect-video bg-gray-200 overflow-hidden mb-6">
              <div class="w-full h-full bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center">
                <span class="text-gray-400">Current Project {i}</span>
              </div>
            </div>
            <h3 class="text-2xl font-light text-gray-900 mb-2">Current Project {i}</h3>
            <p class="text-gray-600 leading-relaxed">
              Description of the ongoing project, its scope, and expected completion.
              This section will be updated with real project information.
            </p>
            <p class="text-sm text-gray-500 mt-4">Status: In Progress</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
