---
import Layout from '../../layouts/Layout.astro'
import { useTranslations } from '../../i18n/utils'

const locale = 'zh'
const t = useTranslations(locale)
const base = import.meta.env.BASE_URL || "/"
---

<Layout title={t.studio.title} locale={locale} description={t.studio.intro.slice(0, 160)}>
  <section class="py-12 px-6">
    <div class="container mx-auto">
      <h1 class="text-4xl font-light tracking-wide text-gray-900 mb-4">{t.studio.title}</h1>

      <div class="grid lg:grid-cols-2 gap-16 mt-12">
        <div>
          <div class="space-y-6 text-gray-600 leading-relaxed">
            <p>{t.studio.intro}</p>
            <p>{t.studio.intro2}</p>
            <p>{t.studio.intro3}</p>
          </div>
        </div>
        <div class="aspect-[4/3] bg-gray-200 overflow-hidden">
          <img src={`${base}images/studio/main.jpg`} alt="TAM ATB Architecture Studio" class="w-full h-full object-cover" />
        </div>
      </div>

      <div class="mt-20">
        <h2 class="text-2xl font-light text-gray-900 mb-6">{t.studio.whatWeDo}</h2>
        <p class="text-gray-600 leading-relaxed max-w-4xl">{t.studio.whatWeDoText}</p>
      </div>

      <div class="mt-20">
        <h2 class="text-2xl font-light text-gray-900 mb-6">{t.studio.philosophy}</h2>
        <div class="space-y-4 text-gray-600 leading-relaxed max-w-4xl">
          <p>{t.studio.philosophyText1}</p>
          <p>{t.studio.philosophyText2}</p>
          <p>{t.studio.philosophyText3}</p>
        </div>
      </div>

      <div class="mt-20">
        <h2 class="text-2xl font-light text-gray-900 mb-12">{t.studio.team}</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-32 h-32 rounded-full bg-gray-200 mx-auto mb-4 overflow-hidden">
              <img src={`${base}images/studio/team-1.jpg`} alt="Victoria Gauna" class="w-full h-full object-cover" />
            </div>
            <h3 class="text-lg font-light text-gray-900">Victoria Gauna</h3>
            <p class="text-sm text-gray-500">{t.studio.architect}</p>
          </div>
          <div class="text-center">
            <div class="w-32 h-32 rounded-full bg-gray-200 mx-auto mb-4 overflow-hidden">
              <img src={`${base}images/studio/team-2.jpg`} alt="Facundo Taborda" class="w-full h-full object-cover" />
            </div>
            <h3 class="text-lg font-light text-gray-900">Facundo Taborda</h3>
            <p class="text-sm text-gray-500">{t.studio.architect}</p>
          </div>
          <div class="text-center">
            <div class="w-32 h-32 rounded-full bg-gray-200 mx-auto mb-4 flex items-center justify-center">
              <span class="text-gray-400 text-xs">Photo</span>
            </div>
            <h3 class="text-lg font-light text-gray-900">Angel Taborda</h3>
            <p class="text-sm text-gray-500">{t.studio.foundingArchitect}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
