---
import Layout from '../../layouts/Layout.astro'
import { useTranslations } from '../../i18n/utils'

const locale = 'zh'
const t = useTranslations(locale)

const constructionProjects = [
  { title: '建筑项目 1', description: '建筑项目的详细描述。', location: '马贝拉', year: '2024', area: '500 m²', status: '已完成' },
  { title: '建筑项目 2', description: '建筑项目的详细描述。', location: '马贝拉', year: '2023', area: '750 m²', status: '已完成' },
  { title: '建筑项目 3', description: '建筑项目的详细描述。', location: '马贝拉', year: '2023', area: '400 m²', status: '进行中' },
]
---

<Layout title={t.obra.title} locale={locale} description={t.obra.subtitle}>
  <section class="py-12 px-6">
    <div class="container mx-auto">
      <h1 class="text-4xl font-light tracking-wide text-gray-900 mb-4">{t.obra.title}</h1>
      <p class="text-gray-600 mb-12 max-w-2xl">{t.obra.subtitle}</p>

      <div class="space-y-16">
        {constructionProjects.map((project, i) => (
          <div class="grid lg:grid-cols-2 gap-8 items-center">
            <div class={`aspect-video bg-gray-200 flex items-center justify-center ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
              <span class="text-gray-400">{project.title}</span>
            </div>
            <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
              <h3 class="text-2xl font-light text-gray-900 mb-4">{project.title}</h3>
              <p class="text-gray-600 leading-relaxed mb-6">{project.description}</p>
              <dl class="grid grid-cols-2 gap-4 text-sm">
                <div><dt class="text-gray-500">位置</dt><dd class="text-gray-900 font-medium">{project.location}</dd></div>
                <div><dt class="text-gray-500">年份</dt><dd class="text-gray-900 font-medium">{project.year}</dd></div>
                <div><dt class="text-gray-500">面积</dt><dd class="text-gray-900 font-medium">{project.area}</dd></div>
                <div><dt class="text-gray-500">状态</dt><dd class="text-gray-900 font-medium">{project.status}</dd></div>
              </dl>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
