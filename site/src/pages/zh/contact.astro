---
import Layout from '../../layouts/Layout.astro'
import { useTranslations } from '../../i18n/utils'

const locale = 'zh'
const t = useTranslations(locale)
const base = (import.meta.env.BASE_URL || "/").replace(/\/*$/, "/")
---

<Layout title={t.contact.title} locale={locale}>
  <section class="py-12 px-6">
    <div class="container mx-auto max-w-5xl">
      <h1 class="text-4xl font-light tracking-wide text-gray-900 mb-12">{t.contact.title}</h1>

      <div class="grid lg:grid-cols-2 gap-16">
        <div>
          <div class="space-y-6 mb-10">
            <div>
              <h3 class="text-sm font-medium text-gray-900 mb-1">TAM ATB Architecture</h3>
              <address class="not-italic text-gray-600 leading-relaxed text-sm">
                Avda. del Prado esq. C/Londres<br />
                Urb. Miragolf. Fase III. 33 - 35<br />
                29660, Nueva Andalucía, Marbella
              </address>
            </div>

            <div>
              <h3 class="text-sm font-medium text-gray-900 mb-1">{t.contact.phone}</h3>
              <p class="text-gray-600 text-sm">
                <a href="tel:+34952810700" class="hover:text-gray-900 transition-colors">(+34) 952 81 07 00</a>
              </p>
            </div>

            <div>
              <h3 class="text-sm font-medium text-gray-900 mb-1">{t.contact.email}</h3>
              <p class="text-gray-600 text-sm">
                <a href="mailto:info@tamatb.com" class="hover:text-gray-900 transition-colors">info@tamatb.com</a>
              </p>
              <p class="text-gray-600 text-sm">
                <a href="mailto:administracion@marbellarchitecture.com" class="hover:text-gray-900 transition-colors">administracion@marbellarchitecture.com</a>
              </p>
            </div>
          </div>

          <div class="aspect-video bg-gray-200 overflow-hidden">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3223.5!2d-4.9575!3d36.4935!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd72f79a7c16a5e7%3A0x3c4c18e78c6b7a4d!2sAvda.%20del%20Prado%2C%20Marbella!5e0!3m2!1sen!2ses!4v1700000000000!5m2!1sen!2ses"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="TAM ATB Architecture Location"
            ></iframe>
          </div>
        </div>

        <div>
          <h2 class="text-2xl font-light text-gray-900 mb-6">{t.contact.getInTouch}</h2>
          <form class="space-y-6" action="https://formsubmit.co/prototype11@gmail.com" method="POST">
            <input type="hidden" name="_subject" value="TAM ATB Website Enquiry" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="text" name="_honey" style="display:none" />

            <div>
              <label for="name" class="block text-sm text-gray-600 mb-2">{t.contact.name}</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 border border-gray-300 focus:border-gray-900 focus:outline-none transition-colors"
              />
            </div>

            <div>
              <label for="telephone" class="block text-sm text-gray-600 mb-2">{t.contact.phone}</label>
              <input
                type="tel"
                id="telephone"
                name="telephone"
                class="w-full px-4 py-3 border border-gray-300 focus:border-gray-900 focus:outline-none transition-colors"
              />
            </div>

            <div>
              <label for="enquiry" class="block text-sm text-gray-600 mb-2">咨询内容</label>
              <textarea
                id="enquiry"
                name="enquiry"
                rows="6"
                required
                class="w-full px-4 py-3 border border-gray-300 focus:border-gray-900 focus:outline-none transition-colors resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="px-8 py-3 bg-gray-900 text-white hover:bg-gray-800 transition-colors text-sm tracking-wide"
            >
              {t.contact.send}
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
