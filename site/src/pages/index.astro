---
import Layout from '../layouts/Layout.astro'
import HeroCarousel from '../components/HeroCarousel.astro'
---

<Layout title="Home">
  <HeroCarousel />

  <!-- Introduction Section -->
  <section class="py-20 px-6">
    <div class="container mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-light tracking-wide text-gray-900 mb-6">
        Architecture with Vision
      </h2>
      <p class="text-gray-600 leading-relaxed">
        TAM ATB Architecture brings innovative design solutions to Marbella and beyond.
        With a focus on contemporary aesthetics and sustainable practices, we create
        spaces that inspire and endure.
      </p>
    </div>
  </section>

  <!-- Featured Projects Preview -->
  <section class="py-20 px-6 bg-gray-50">
    <div class="container mx-auto">
      <h3 class="text-2xl font-light tracking-wide text-gray-900 mb-12 text-center">
        Featured Projects
      </h3>
      <div class="grid md:grid-cols-3 gap-8">
        {[1, 2, 3].map((i) => (
          <a href="/projects" class="group">
            <div class="aspect-[4/3] bg-gray-200 overflow-hidden">
              <div class="w-full h-full bg-gradient-to-br from-gray-200 to-gray-300 group-hover:scale-105 transition-transform duration-500 flex items-center justify-center">
                <span class="text-gray-400">Project {i}</span>
              </div>
            </div>
            <h4 class="mt-4 text-lg font-light text-gray-900">Project Title {i}</h4>
            <p class="text-sm text-gray-500">Marbella, Spain</p>
          </a>
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="/projects" class="btn btn-outline">
          View All Projects
        </a>
      </div>
    </div>
  </section>
</Layout>
