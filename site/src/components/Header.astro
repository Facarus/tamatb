---
const menuItems = [
  { name: 'Projects', href: '/projects' },
  { name: 'Present', href: '/present' },
  { name: 'Studio', href: '/studio' },
  { name: 'Obra', href: '/obra' },
  { name: 'Videos', href: '/videos' },
  { name: 'Contact', href: '/contact' },
]
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
  <div class="container mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo & Slogan -->
      <a href="/" class="flex items-center gap-4">
        <!-- Logo Placeholder -->
        <div class="w-12 h-12 bg-gray-200 flex items-center justify-center text-gray-500 text-xs font-medium">
          LOGO
        </div>
        <div class="hidden sm:block">
          <h1 class="text-lg font-medium tracking-wide text-gray-900">TAM ATB</h1>
          <p class="text-xs text-gray-500 tracking-widest uppercase">Architecture</p>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8">
        {menuItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-light tracking-wide text-gray-600 hover:text-gray-900 transition-colors"
          >
            {item.name}
          </a>
        ))}
      </nav>

      <!-- Hamburger Menu Button -->
      <button
        id="menu-toggle"
        class="lg:hidden p-2 -mr-2"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            id="menu-icon"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <nav
    id="mobile-menu"
    class="hidden lg:hidden bg-white border-t border-gray-100"
  >
    <div class="container mx-auto px-6 py-4 space-y-4">
      {menuItems.map((item) => (
        <a
          href={item.href}
          class="block text-sm font-light tracking-wide text-gray-600 hover:text-gray-900 transition-colors py-2"
        >
          {item.name}
        </a>
      ))}
    </div>
  </nav>
</header>

<!-- Spacer for fixed header -->
<div class="h-20"></div>

<script>
  const menuToggle = document.getElementById('menu-toggle')
  const mobileMenu = document.getElementById('mobile-menu')
  const menuIcon = document.getElementById('menu-icon')

  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden')
    if (menuIcon) {
      menuIcon.setAttribute('d', isOpen === false
        ? 'M6 18L18 6M6 6l12 12'
        : 'M4 6h16M4 12h16M4 18h16'
      )
    }
  })
</script>
