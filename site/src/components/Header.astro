---
import { useTranslations, getLocalizedPath, type Locale } from '../i18n/utils'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const t = useTranslations(locale)

const menuItems = [
  { name: t.nav.projects, href: getLocalizedPath('/projects', locale) },
  { name: t.nav.present, href: getLocalizedPath('/present', locale) },
  { name: t.nav.studio, href: getLocalizedPath('/studio', locale) },
  { name: t.nav.obra, href: getLocalizedPath('/obra', locale) },
  { name: t.nav.videos, href: getLocalizedPath('/videos', locale) },
  { name: t.nav.contact, href: getLocalizedPath('/contact', locale) },
]

const languages = [
  { code: 'EN', locale: 'en' as Locale, name: 'English' },
  { code: 'ES', locale: 'es' as Locale, name: 'Español' },
  { code: 'ZH', locale: 'zh' as Locale, name: '中文' },
]

// Get current path without locale prefix for language switching
const currentPath = Astro.url.pathname.replace(/^\/(en|es|zh)/, '') || '/'
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
  <div class="container mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo & Slogan -->
      <a href={getLocalizedPath('/', locale)} class="flex items-center gap-4">
        <!-- Logo -->
        <img src="/images/logo/logo.png" alt="TAM ATB Logo" class="w-12 h-12 object-contain" />
        <div class="hidden sm:block">
          <h1 class="text-lg font-medium tracking-wide text-gray-900">TAM ATB</h1>
          <p class="text-xs text-gray-500 tracking-widest uppercase">Architecture</p>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8">
        {menuItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-light tracking-wide text-gray-600 hover:text-gray-900 transition-colors"
          >
            {item.name}
          </a>
        ))}

        <!-- Language Selector (Desktop) -->
        <div class="flex items-center gap-2 ml-4 pl-4 border-l border-gray-200">
          {languages.map((lang) => (
            <a
              href={getLocalizedPath(currentPath, lang.locale)}
              class={`text-xs font-medium tracking-wide transition-colors ${
                lang.locale === locale
                  ? 'text-gray-900'
                  : 'text-gray-400 hover:text-gray-600'
              }`}
              title={lang.name}
            >
              {lang.code}
            </a>
          ))}
        </div>
      </nav>

      <!-- Language + Hamburger Menu Button -->
      <div class="lg:hidden flex items-center gap-4">
        <!-- Language Selector (Mobile - compact) -->
        <div class="flex items-center gap-1">
          {languages.map((lang) => (
            <a
              href={getLocalizedPath(currentPath, lang.locale)}
              class={`text-xs font-medium tracking-wide transition-colors px-1 ${
                lang.locale === locale
                  ? 'text-gray-900'
                  : 'text-gray-400 hover:text-gray-600'
              }`}
              title={lang.name}
            >
              {lang.code}
            </a>
          ))}
        </div>

        <!-- Hamburger -->
        <button
          id="menu-toggle"
          class="p-2 -mr-2"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              id="menu-icon"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <nav
    id="mobile-menu"
    class="hidden lg:hidden bg-white border-t border-gray-100"
  >
    <div class="container mx-auto px-6 py-4 space-y-4">
      {menuItems.map((item) => (
        <a
          href={item.href}
          class="block text-sm font-light tracking-wide text-gray-600 hover:text-gray-900 transition-colors py-2"
        >
          {item.name}
        </a>
      ))}
    </div>
  </nav>
</header>

<!-- Spacer for fixed header -->
<div class="h-20"></div>

<script>
  const menuToggle = document.getElementById('menu-toggle')
  const mobileMenu = document.getElementById('mobile-menu')
  const menuIcon = document.getElementById('menu-icon')

  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden')
    if (menuIcon) {
      menuIcon.setAttribute('d', isOpen === false
        ? 'M6 18L18 6M6 6l12 12'
        : 'M4 6h16M4 12h16M4 18h16'
      )
    }
  })
</script>
