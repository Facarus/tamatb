<div class="lightbox-backdrop" id="lbBackdrop"></div>
<div class="lightbox-stage" id="lbStage">
  <div class="lb-controls-top">
    <button class="lb-btn lb-info-toggle" id="lbInfoBtn" title="Project info">i</button>
    <button class="lb-btn lb-close" id="lbClose" title="Close (Esc)">&times;</button>
  </div>

  <div class="lb-spinner" id="lbSpinner">
    <svg viewBox="0 0 100 100" class="lb-spinner-svg">
      <rect x="5" y="5" width="90" height="90" rx="2" ry="2" class="lb-spinner-rect" />
    </svg>
  </div>

  <div class="lightbox-panel" id="lbPanel">
    <img class="lightbox-image" id="lbImage" src="" alt="">

    <div class="lb-info-overlay" id="lbInfoOverlay">
      <div class="lb-info-title" id="lbInfoTitle"></div>
      <div class="lb-info-meta" id="lbInfoMeta"></div>
      <div class="lb-info-text" id="lbInfoText"></div>
    </div>
  </div>

  <div class="lb-controls-bottom">
    <div class="lb-img-nav">
      <button class="lb-btn" id="lbPrevImg" title="Previous image (←)">&#8249;</button>
      <button class="lb-btn" id="lbNextImg" title="Next image (→)">&#8250;</button>
    </div>

    <div class="lb-counter" id="lbCounter"></div>

    <div class="lb-proj-nav">
      <button class="lb-btn" id="lbPrevProj" title="Previous project (↑)">&#171;</button>
      <span class="lb-proj-label" id="lbProjLabel"></span>
      <button class="lb-btn" id="lbNextProj" title="Next project (↓)">&#187;</button>
    </div>
  </div>
</div>
