---
import type { Project } from '../../data/projects'

interface Props {
  project: Project
  direction: 'up' | 'down'
  tileIndex?: number
}

const { project, direction, tileIndex = 0 } = Astro.props
const base = (import.meta.env.BASE_URL || "/").replace(/\/*$/, "/")

// Build responsive image paths for grid thumbnails
const gridImg = project.gridImage // e.g. "images/main-upscaled/k-s-villa.jpg"
const gridDir = gridImg.replace(/\/([^/]+)$/, '') // "images/main-upscaled"
const gridFile = gridImg.replace(/.*\//, '')       // "k-s-villa.jpg"
const smSrc = `${base}${gridDir}/sm/${gridFile}`
const mdSrc = `${base}${gridDir}/md/${gridFile}`
const lgSrc = `${base}${gridDir}/lg/${gridFile}`

function hashCode(s: string): number {
  let h = 0
  for (let i = 0; i < s.length; i++) h = ((h << 5) - h + s.charCodeAt(i)) | 0
  return Math.abs(h)
}
const h = hashCode(project.id)
const g1 = 25 + (h % 30)
const g2 = 45 + ((h >> 8) % 35)
const angle = 120 + (h % 80)
---

<div
  class="tile"
  data-project={project.id}
  data-tile-index={tileIndex}
  style={`--grad-from: ${g1}; --grad-to: ${g2}; --grad-angle: ${angle}deg;`}
>
  <img
    src={lgSrc}
    srcset={`${smSrc} 400w, ${mdSrc} 600w, ${lgSrc} 800w`}
    sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
    alt={project.title}
  />
  <div class="tile-overlay"></div>
  <div class="tile-info">
    <div class="tile-info-bg"></div>
    <span class="label">{project.title}</span>
    <div class="meta">
      <div class="meta-line">{project.state}</div>
      <div class="meta-line">{project.location}</div>
      <div class="meta-line">{project.typology}</div>
      <div class="meta-line">{project.year}</div>
    </div>
  </div>
</div>
