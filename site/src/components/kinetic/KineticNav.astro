---
import { useTranslations, getLocalizedPath, type Locale } from '../../i18n/utils'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const t = useTranslations(locale)
const base = (import.meta.env.BASE_URL || "/").replace(/\/*$/, "/")
---

<nav class="nav-overlay" id="navOverlay">
  <a href="#" class="logo" data-page="built">
    <img src={`${base}images/logo/logo-white.png`} alt="TAM ATB Architecture" onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
    <span class="logo-text" style="display:none">TAM ATB</span>
  </a>
  <div class="nav-menu">
    <a href="#" data-page="studio">{t.nav.studio}</a>
    <a href="#" data-page="present">{t.nav.present}</a>
    <a href="#" data-page="built">{t.kinetic.built}</a>
    <a href="#" data-page="videos">{t.nav.videos}</a>
    <a href="#" data-page="contact">{t.nav.contact}</a>
  </div>
</nav>
