---
import { useTranslations, type Locale } from '../../i18n/utils'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const t = useTranslations(locale)
const base = (import.meta.env.BASE_URL || "/").replace(/\/*$/, "/")

const enquiryLabel = locale === 'es' ? 'Consulta' : locale === 'zh' ? '咨询内容' : 'Enquiry'
const telephoneLabel = locale === 'es' ? 'Teléfono' : locale === 'zh' ? '电话' : 'Telephone'
---

<!-- Page overlay backdrop -->
<div class="page-backdrop" id="pageBackdrop"></div>

<!-- ===== STUDIO ===== -->
<div class="page-overlay" id="pageStudio" data-page="studio">
  <button class="page-close" id="pageCloseStudio" title="Close (Esc)">&times;</button>
  <div class="page-content">
    <div class="page-two-squares">
      <div class="page-square page-square-image">
        <img
          src={`${base}images/studio/main.jpg`}
          alt="TAM ATB Architecture Studio"
          onerror="this.parentElement.style.background='linear-gradient(135deg,#1a1a1a,#2a2a2a)'"
        />
      </div>
      <div class="page-square page-square-text">
        <h1>{t.studio.title}</h1>
        <div class="page-body">
          <p>{t.studio.intro}</p>
          <p>{t.studio.intro2}</p>
        </div>
        <div class="page-divider"></div>
        <h2>{t.studio.philosophy}</h2>
        <p class="page-body-secondary">{t.studio.philosophyText1}</p>
        <div class="page-team">
          <span>Victoria Gauna — {t.studio.architect}</span>
          <span>Facundo Taborda — {t.studio.architect}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ===== VIDEOS ===== -->
<div class="page-overlay" id="pageVideos" data-page="videos">
  <button class="page-close" id="pageCloseVideos" title="Close (Esc)">&times;</button>
  <div class="page-content">
    <div class="video-grid-wrap">
      <div class="video-grid" id="videoGrid">
        <div class="video-circle" data-youtube="">
          <img src={`${base}images/videos/elements-tribute.jpg`} alt="Elements — Tribute to ATB" />
          <span class="video-circle-title">Elements</span>
        </div>
        <div class="video-circle" data-youtube="KQJ3Vlppr8s">
          <img src={`${base}images/videos/estadio-plaza.jpg`} alt="Estadio Plaza de Marbella" />
          <span class="video-circle-title">Estadio Plaza</span>
        </div>
        <div class="video-circle" data-youtube="">
          <img src={`${base}images/videos/house-la-quinta.jpg`} alt="House in La Quinta" />
          <span class="video-circle-title">La Quinta</span>
        </div>
        <div class="video-circle" data-youtube="_60H61Y39GA">
          <img src={`${base}images/videos/house-monte-mayor.jpg`} alt="House in Monte Mayor" />
          <span class="video-circle-title">Monte Mayor</span>
        </div>
        <div class="video-circle" data-youtube="">
          <img src={`${base}images/videos/villa-aloha.jpg`} alt="Villa Aloha" />
          <span class="video-circle-title">Villa Aloha</span>
        </div>
        <div class="video-circle" data-youtube="NREIthXZypM">
          <img src={`${base}images/videos/villa-elviria.jpg`} alt="Villa Elviria" />
          <span class="video-circle-title">Villa Elviria</span>
        </div>
        <div class="video-circle" data-youtube="XyDlUNfhS7E">
          <img src={`${base}images/videos/asb-riyadh.jpg`} alt="ASB — Riyadh" />
          <span class="video-circle-title">ASB Riyadh</span>
        </div>
        <div class="video-circle" data-youtube="">
          <img src={`${base}images/videos/ocean-villa.jpg`} alt="Ocean Villa" />
          <span class="video-circle-title">Ocean Villa</span>
        </div>
        <div class="video-circle" data-youtube="BhdIKkgsZWg">
          <img src={`${base}images/videos/istan-hotel.jpg`} alt="Istan Hotel" />
          <span class="video-circle-title">Istan Hotel</span>
        </div>
        <div class="video-circle" data-youtube="qqNt4hFyIfM">
          <img src={`${base}images/videos/tq-tower.jpg`} alt="TQ Tower" />
          <span class="video-circle-title">TQ Tower</span>
        </div>
        <div class="video-circle" data-youtube="">
          <img src={`${base}images/videos/sierra-blanca.jpg`} alt="Sierra Blanca" />
          <span class="video-circle-title">Sierra Blanca</span>
        </div>
        <div class="video-circle" data-youtube="L23TjhfOHc4">
          <img src={`${base}images/videos/hotel-peral.jpg`} alt="Hotel Peral" />
          <span class="video-circle-title">Hotel Peral</span>
        </div>
        <div class="video-circle" data-youtube="_lSGARbVMGA">
          <img src={`${base}images/videos/villa-atb.jpg`} alt="Villa ATB" />
          <span class="video-circle-title">Villa ATB</span>
        </div>
        <div class="video-circle" data-youtube="7Cl9MmndYs8">
          <img src={`${base}images/videos/desert-club.jpg`} alt="Desert Club" />
          <span class="video-circle-title">Desert Club</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Inline video player -->
  <div class="video-player-overlay" id="videoPlayerOverlay">
    <div class="video-player-wrap">
      <button class="video-player-close" id="videoPlayerClose">&times;</button>
      <iframe id="videoPlayerFrame" src="" allow="autoplay; encrypted-media" allowfullscreen></iframe>
    </div>
  </div>
</div>

<!-- ===== CONTACT ===== -->
<div class="page-overlay" id="pageContact" data-page="contact">
  <button class="page-close" id="pageCloseContact" title="Close (Esc)">&times;</button>
  <div class="page-content">
    <div class="page-two-columns">
      <div class="page-col-info">
        <h1>{t.contact.title}</h1>

        <div class="contact-block">
          <h3>TAM ATB Architecture</h3>
          <address>
            Avda. del Prado esq. C/Londres<br />
            Urb. Miragolf. Fase III. 33 - 35<br />
            29660, Nueva Andalucía, Marbella
          </address>
        </div>

        <div class="contact-block">
          <h3>{t.contact.phone}</h3>
          <a href="tel:+34952810700">(+34) 952 81 07 00</a>
        </div>

        <div class="contact-block">
          <h3>{t.contact.email}</h3>
          <a href="mailto:info@tamatb.com">info@tamatb.com</a><br />
          <a href="mailto:administracion@marbellarchitecture.com">administracion@marbellarchitecture.com</a>
        </div>

        <div class="contact-map">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3223.5!2d-4.9575!3d36.4935!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd72f79a7c16a5e7%3A0x3c4c18e78c6b7a4d!2sAvda.%20del%20Prado%2C%20Marbella!5e0!3m2!1sen!2ses!4v1700000000000!5m2!1sen!2ses"
            width="100%"
            height="100%"
            style="border:0; filter: invert(90%) hue-rotate(180deg) brightness(0.9) contrast(1.1);"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="TAM ATB Architecture"
          ></iframe>
        </div>
      </div>

      <div class="page-col-form">
        <h2>{t.contact.getInTouch}</h2>
        <form action="https://formsubmit.co/prototype11@gmail.com" method="POST">
          <input type="hidden" name="_subject" value="TAM ATB Website Enquiry" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="text" name="_honey" style="display:none" />

          <label for="pg-name">{t.contact.name}</label>
          <input type="text" id="pg-name" name="name" required />

          <label for="pg-tel">{telephoneLabel}</label>
          <input type="tel" id="pg-tel" name="telephone" />

          <label for="pg-enq">{enquiryLabel}</label>
          <textarea id="pg-enq" name="enquiry" rows="5" required></textarea>

          <button type="submit">{t.contact.send}</button>
        </form>
      </div>
    </div>
  </div>
</div>
